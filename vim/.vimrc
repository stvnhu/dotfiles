
set number
set relativenumber
set cursorline

set tabstop=4
set softtabstop=4
set shiftwidth=0
set expandtab
set breakindent

set ignorecase
set smartcase

set hlsearch
set incsearch

set splitbelow
set splitright

set updatetime=250
set timeoutlen=250
set confirm

let mapleader = " "

nnoremap <esc> :nohlsearch<cr>
nnoremap <leader>q :q<cr>
nnoremap <leader>w :w<cr>
